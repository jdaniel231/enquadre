<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 11pt;
      color: #1E1B18;
      margin: 0;
      padding: 0;
      line-height: 1.6;
    }
    .clinic-name {
      font-size: 9pt;
      color: #666;
      margin: 0 0 4px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .doc-title {
      font-size: 18pt;
      font-weight: bold;
      margin: 0 0 4px;
    }
    .doc-date {
      font-size: 9pt;
      color: #666;
      margin: 0 0 24px;
    }
    .doc-meta {
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid #ddd;
    }
    .doc-meta p, .doc-content p, .doc-amount p {
      margin: 4px 0;
    }
    .doc-content {
      margin-bottom: 24px;
      min-height: 200px;
    }
    .doc-amount {
      margin-bottom: 24px;
      padding: 12px;
      background: #f9f9f7;
      border-left: 3px solid #8A3324;
    }
    .doc-signature {
      margin-top: 48px;
      padding-top: 12px;
      border-top: 1px solid #ddd;
      font-size: 9pt;
      color: #555;
    }
  </style>
</head>
<body>
  <%= raw body %>
</body>
</html>
