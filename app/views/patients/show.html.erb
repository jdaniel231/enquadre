<% content_for :title, @patient.full_name %>

<div class="max-w-2xl">
  <div class="flex items-start justify-between mb-8">
    <div>
      <p class="text-sm text-ink/40 mb-1"><%= link_to t("patients.index.title"), patients_path, class: "hover:text-accent" %></p>
      <h1 class="text-3xl font-semibold"><%= @patient.full_name %></h1>
    </div>
    <%= link_to t("general.edit"), edit_patient_path(@patient),
        class: "bg-white/60 border border-ink/15 px-4 py-2 rounded text-sm hover:bg-white transition-colors" %>
  </div>

  <dl class="bg-white/60 border border-ink/10 rounded-lg divide-y divide-ink/5">
    <% {
      t("patients.form.cpf") => @patient.cpf,
      t("patients.form.date_of_birth") => (@patient.date_of_birth&.strftime("%d/%m/%Y")),
      t("patients.form.phone") => @patient.phone,
      t("patients.form.email") => @patient.email
    }.each do |label, value| %>
      <div class="flex px-4 py-3 text-sm gap-4">
        <dt class="text-ink/40 w-40 shrink-0"><%= label %></dt>
        <dd class="text-ink"><%= value.presence || "—" %></dd>
      </div>
    <% end %>

    <% if @patient.notes.present? %>
      <div class="px-4 py-3 text-sm">
        <dt class="text-ink/40 mb-1"><%= t("patients.form.notes") %></dt>
        <dd class="text-ink whitespace-pre-wrap"><%= @patient.notes %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold"><%= t("record_entries.section_title") %></h2>
      <%= link_to t("record_entries.new"), new_patient_record_entry_path(@patient),
          class: "text-sm text-accent hover:underline" %>
    </div>
    <% if @record_entries.any? %>
      <div class="bg-white/60 border border-ink/10 rounded-lg divide-y divide-ink/5">
        <% @record_entries.first(3).each do |entry| %>
          <%= link_to patient_record_entry_path(@patient, entry),
              class: "flex items-center justify-between px-4 py-3 text-sm hover:bg-white/80 transition-colors" do %>
            <span class="font-medium"><%= entry.created_at.strftime("%d/%m/%Y %H:%M") %></span>
            <span class="text-ink/30 text-xs"><%= entry.body.truncate(60) %></span>
          <% end %>
        <% end %>
        <% if @record_entries.size > 3 %>
          <div class="px-4 py-2 text-center">
            <%= link_to t("record_entries.index.see_all"), patient_record_entries_path(@patient),
                class: "text-xs text-accent hover:underline" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white/60 border border-ink/10 rounded-lg px-4 py-6 text-center text-sm text-ink/30">
        <%= link_to t("record_entries.new"), new_patient_record_entry_path(@patient), class: "hover:text-accent" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold"><%= t("private_notes.section_title") %></h2>
      <%= link_to t("private_notes.new_short"), new_patient_private_note_path(@patient),
          class: "text-sm text-accent hover:underline" %>
    </div>
    <% if @private_notes.any? %>
      <div class="bg-white/60 border border-ink/10 rounded-lg divide-y divide-ink/5">
        <% @private_notes.first(3).each do |note| %>
          <div class="flex items-start justify-between px-4 py-3 text-sm gap-4">
            <div class="min-w-0">
              <p class="text-xs text-ink/40 mb-0.5"><%= note.created_at.strftime("%d/%m/%Y %H:%M") %></p>
              <p class="text-ink whitespace-pre-wrap line-clamp-3"><%= note.body %></p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to t("general.edit"), edit_patient_private_note_path(@patient, note),
                  class: "text-xs text-ink/40 hover:text-accent" %>
              <%= button_to t("general.delete"), patient_private_note_path(@patient, note),
                  method: :delete,
                  data: { turbo_confirm: t("private_notes.confirm_delete") },
                  class: "text-xs text-ink/30 hover:text-red-600 transition-colors bg-transparent border-0 p-0 cursor-pointer" %>
            </div>
          </div>
        <% end %>
        <% if @private_notes.size > 3 %>
          <p class="px-4 py-2 text-xs text-ink/30 text-center">
            +<%= @private_notes.size - 3 %> <%= t("private_notes.more") %>
            · <%= link_to t("private_notes.new_short"), new_patient_private_note_path(@patient), class: "text-accent hover:underline" %>
          </p>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white/60 border border-ink/10 rounded-lg px-4 py-6 text-center text-sm text-ink/30">
        <%= link_to t("private_notes.new_short"), new_patient_private_note_path(@patient), class: "hover:text-accent" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold"><%= t("care_plans.section_title") %></h2>
      <%= link_to t("care_plans.new"), new_patient_care_plan_path(@patient),
          class: "text-sm text-accent hover:underline" %>
    </div>

    <% if @care_plans.any? %>
      <div class="bg-white/60 border border-ink/10 rounded-lg divide-y divide-ink/5">
        <% @care_plans.each do |plan| %>
          <div class="flex items-center justify-between px-4 py-3 text-sm">
            <div>
              <p class="font-medium">
                <%= number_to_currency(plan.fee, unit: "R$", separator: ",", delimiter: ".") %>
                <span class="text-ink/40 font-normal">/ <%= t("care_plans.billing_modes.#{plan.billing_mode}").downcase %></span>
              </p>
              <p class="text-ink/40 text-xs mt-0.5">
                <%= t("care_plans.form.sessions_per_week_option", count: plan.sessions_per_week) %> ·
                <%= plan.session_duration_minutes %> min
              </p>
            </div>
            <div class="flex items-center gap-3">
              <% unless plan.active? %>
                <span class="text-xs text-ink/30"><%= t("care_plans.inactive") %></span>
              <% end %>
              <%= link_to t("general.edit"), edit_care_plan_path(plan), class: "text-xs text-ink/40 hover:text-accent" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white/60 border border-ink/10 rounded-lg px-4 py-6 text-center text-sm text-ink/30">
        <%= link_to t("care_plans.new"), new_patient_care_plan_path(@patient), class: "hover:text-accent" %>
      </div>
    <% end %>
  </div>
</div>
