<%= form_with model: [patient, private_note] do |f| %>
  <% if private_note.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% private_note.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white/60 border border-ink/10 rounded-lg p-4">
    <div class="mb-4">
      <%= f.label :body, t("private_notes.form.body"), class: "block text-sm text-ink/60 mb-1" %>
      <%= f.text_area :body, rows: 10,
          class: "w-full bg-transparent border border-ink/15 rounded px-3 py-2 text-sm text-ink placeholder-ink/30 focus:outline-none focus:ring-1 focus:ring-accent resize-y",
          placeholder: t("private_notes.form.body_placeholder") %>
    </div>

    <div class="flex items-center justify-end gap-3">
      <%= link_to t("general.cancel"), patient,
          class: "text-sm text-ink/40 hover:text-ink" %>
      <%= f.submit t("private_notes.form.submit"),
          class: "bg-accent text-paper px-4 py-2 rounded text-sm hover:bg-accent/90 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
