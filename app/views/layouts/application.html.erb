<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} — Enquadre" : "Enquadre" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Enquadre">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <% if authenticated? %>
      <header class="border-b border-ink/10 bg-paper/80 backdrop-blur-sm sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between">
          <div class="flex items-center gap-6">
            <%= link_to "Enquadre", root_path, class: "font-display font-semibold text-ink hover:text-accent transition-colors" %>
            <nav class="flex items-center gap-1">
              <%= link_to "Pacientes", patients_path,
                  class: "px-3 py-1.5 rounded text-sm hover:bg-ink/5 transition-colors #{request.path.start_with?('/patients') ? 'text-accent font-medium' : 'text-ink/60'}" %>
              <%= link_to "Agenda", appointments_path,
                  class: "px-3 py-1.5 rounded text-sm hover:bg-ink/5 transition-colors #{request.path.start_with?('/appointments') ? 'text-accent font-medium' : 'text-ink/60'}" %>
            </nav>
          </div>
          <div class="flex items-center gap-3 text-sm text-ink/50">
            <span><%= Current.user&.email_address %></span>
            <%= button_to "Sair", session_path, method: :delete,
                class: "text-ink/40 hover:text-accent text-sm transition-colors" %>
          </div>
        </div>
      </header>
    <% end %>

    <% if notice.present? %>
      <div class="bg-green-50 border-b border-green-200 px-5 py-2 text-sm text-green-700 text-center">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="bg-red-50 border-b border-red-200 px-5 py-2 text-sm text-red-700 text-center">
        <%= alert %>
      </div>
    <% end %>

    <main class="max-w-5xl mx-auto w-full px-5 py-8 flex-1">
      <%= yield %>
    </main>
  </body>
</html>
