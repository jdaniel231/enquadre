<% content_for :title, t(".title") %>

<div class="flex items-center justify-between mb-8">
  <h1 class="text-3xl font-semibold"><%= t(".title") %></h1>
  <%= link_to t(".new_patient"), new_patient_path,
      class: "bg-accent hover:bg-accent-dark text-paper px-4 py-2 rounded text-sm font-medium transition-colors" %>
</div>

<% if @patients.any? %>
  <div class="bg-white/60 rounded-lg border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-ink/10">
        <tr class="text-left text-ink/50 text-xs uppercase tracking-wide">
          <th class="px-4 py-3"><%= t(".name") %></th>
          <th class="px-4 py-3"><%= t(".phone") %></th>
          <th class="px-4 py-3"><%= t(".email") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink/5">
        <% @patients.each do |patient| %>
          <tr class="hover:bg-ink/5 transition-colors">
            <td class="px-4 py-3 font-medium">
              <%= link_to patient.full_name, patient, class: "hover:text-accent" %>
            </td>
            <td class="px-4 py-3 text-ink/60"><%= patient.phone.presence || "—" %></td>
            <td class="px-4 py-3 text-ink/60"><%= patient.email.presence || "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t(".edit"), edit_patient_path(patient), class: "text-ink/40 hover:text-accent text-xs" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 text-ink/40">
    <p class="font-display text-xl mb-2"><%= t(".empty_title") %></p>
    <p class="text-sm mb-6"><%= t(".empty_body") %></p>
    <%= link_to t(".new_patient"), new_patient_path, class: "text-accent hover:underline text-sm" %>
  </div>
<% end %>
