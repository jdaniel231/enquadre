<% content_for :title, t("registrations.title") %>

<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <h1 class="text-3xl font-semibold text-accent mb-2">Enquadre</h1>
    <p class="text-ink/60 mb-8"><%= t("registrations.subtitle") %></p>

    <%= form_with model: @registration, url: registration_path, data: { controller: "registration" } do |f| %>
      <% if @registration.errors.any? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
          <% @registration.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= f.label :account_name, t("registrations.account_name"), class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :account_name, class: "w-full border border-ink/20 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent/40", autocomplete: "organization" %>
        </div>

        <div>
          <%= f.label :email_address, t("sessions.new.email_label"), class: "block text-sm font-medium mb-1" %>
          <%= f.email_field :email_address, class: "w-full border border-ink/20 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent/40", autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :password, t("sessions.new.password_label"), class: "block text-sm font-medium mb-1" %>
          <%= f.password_field :password, class: "w-full border border-ink/20 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent/40", autocomplete: "new-password" %>
          <p class="text-xs text-ink/50 mt-1"><%= t("registrations.password_hint") %></p>
        </div>

        <div>
          <%= f.label :kind, t("registrations.kind"), class: "block text-sm font-medium mb-1" %>
          <%= f.select :kind,
            [
              [t("professional_profile.kinds.psychoanalyst"), "psychoanalyst"],
              [t("professional_profile.kinds.psychologist"), "psychologist"]
            ],
            {},
            class: "w-full border border-ink/20 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent/40",
            data: { action: "change->registration#toggleCrp" } %>
        </div>

        <div data-registration-target="crpField" class="hidden">
          <%= f.label :crp, t("registrations.crp"), class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :crp, placeholder: "00000/UF", class: "w-full border border-ink/20 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent/40" %>
        </div>
      </div>

      <%= f.submit t("registrations.submit"), class: "mt-6 w-full bg-accent text-white py-2 px-4 rounded font-medium hover:bg-accent-dark transition-colors cursor-pointer" %>
    <% end %>

    <p class="mt-4 text-center text-sm text-ink/60">
      <%= t("registrations.already_have_account") %>
      <%= link_to t("sessions.new.submit"), new_session_path, class: "text-accent hover:underline" %>
    </p>
  </div>
</div>
